{
  "name": "@gyeol-ui/tokens",
  "version": "0.0.0",
  "description": "gyeol-ui의 Design Token",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyeol-ui/gyeol-ui.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts && tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "change-case": "5.4.4",
    "publint": "0.3.25",
    "style-dictionary": "5.8.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
