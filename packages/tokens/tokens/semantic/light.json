{
  "bg-surface": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "bg-subtle": {
    "$type": "color",
    "$value": "{color.gray.50}"
  },
  "fg-default": {
    "$type": "color",
    "$value": "{color.gray.900}"
  },
  "fg-muted": {
    "$type": "color",
    "$value": "{color.gray.500}"
  },
  "border-default": {
    "$type": "color",
    "$value": "{color.gray.200}"
  },
  "bg-accent": {
    "$type": "color",
    "$value": "{color.blue.600}"
  },
  "fg-on-accent": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "ring-offset": {
    "$type": "color",
    "$value": "{bg-surface}"
  },
  "alpha": {
    "90": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.9
      },
      "$extensions": {
        "gyeol": {
          "alias": { "ref": "{bg-surface}", "alpha": 0.9 }
        }
      }
    }
  }
}
