{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["docs/learning/vendor/**"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  }
}
