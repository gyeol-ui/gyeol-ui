{
  "bg-surface": {
    "$type": "color",
    "$value": "{color.gray.950}"
  },
  "bg-subtle": {
    "$type": "color",
    "$value": "{color.gray.900}"
  },
  "fg-default": {
    "$type": "color",
    "$value": "{color.gray.50}"
  },
  "fg-muted": {
    "$type": "color",
    "$value": "{color.gray.400}"
  },
  "border-default": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "alpha": 0.1
    },
    "$extensions": {
      "gyeol": {
        "alias": { "ref": "{color.white}", "alpha": 0.1 }
      }
    }
  },
  "bg-accent": {
    "$type": "color",
    "$value": "{color.blue.300}"
  },
  "fg-on-accent": {
    "$type": "color",
    "$value": "{color.gray.950}"
  },
  "ring-offset": {
    "$type": "color",
    "$value": "{bg-surface}"
  },
  "alpha": {
    "90": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0353, 0.0353, 0.0431],
        "alpha": 0.9
      },
      "$extensions": {
        "gyeol": {
          "alias": { "ref": "{bg-surface}", "alpha": 0.9 }
        }
      }
    }
  }
}
